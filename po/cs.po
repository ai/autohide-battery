#: prefs.js:27
msgid "If you changed maximum charging level to extend battery life"
msgstr ""
"V případě, že jste kvůli prodloužení životnosti akumulátoru omezili "
"procenta, na jaké může být nabíjen"

#: prefs.js:29
msgid "Hide on battery level above"
msgstr "Skrýt při úrovni nabití nad"

#: prefs.js:43
msgid "For laptops often jumping between charging and discharging"
msgstr "Pro notebooky, které často přecházejí mezi nabíjením a vybíjením"

#: prefs.js:45
msgid "Hide battery even on discharge if the level is above"
msgstr "Skrýt akumulátor i když je vybíjeno, pokud je nabití nad"
